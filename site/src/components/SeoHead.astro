---
import { siteConfig } from '../data/siteConfig';

interface Props {
  title: string;
  description: string;
  path: string;
  lang: 'it' | 'en' | 'de';
  alternatePath?: string;
  alternatePaths?: Partial<Record<'it' | 'en' | 'de', string>>;
  schema?: unknown;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
}

const { title, description, path, lang, alternatePath, alternatePaths, schema, noindex = false, ogType = 'website', socialImage: socialImagePath, socialImageAlt, socialImageWidth, socialImageHeight } = Astro.props;
const canonical = new URL(path, siteConfig.siteUrl).toString();
const alternateLang = lang === 'it' ? 'en' : 'it';
const alternateUrl = alternatePath ? new URL(alternatePath, siteConfig.siteUrl).toString() : undefined;
const socialImage = new URL(socialImagePath || '/images/perla-toscana/perla-toscana-hero-camera-principale-9.jpg', siteConfig.siteUrl).toString();
const resolvedSocialAlt = socialImageAlt || (lang === 'it' ? 'Camera matrimoniale di Perla Toscana a Figline Valdarno' : 'Double bedroom at Perla Toscana in Figline Valdarno');
const isHome = ['/it/', '/en/', '/de/'].includes(path);
const homeAlternates = ['it', 'en', 'de'] as const;
const localizedAlternates = alternatePaths
  ? Object.entries(alternatePaths).filter((entry): entry is ['it' | 'en' | 'de', string] => Boolean(entry[1]))
  : [];
---
<title>{title}</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={lang === 'it' ? 'it_IT' : lang === 'de' ? 'de_DE' : 'en_US'} />
{isHome ? homeAlternates.filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={code === 'it' ? 'it_IT' : code === 'de' ? 'de_DE' : 'en_US'} />) : <meta property="og:locale:alternate" content={lang === 'it' ? 'en_US' : 'it_IT'} />}
<meta property="og:image" content={socialImage} />
{socialImageWidth && <meta property="og:image:width" content={socialImageWidth} />}
{socialImageHeight && <meta property="og:image:height" content={socialImageHeight} />}
<meta property="og:image:alt" content={resolvedSocialAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
{isHome ? homeAlternates.map((code) => <link rel="alternate" hreflang={code} href={new URL(`/${code}/`, siteConfig.siteUrl).toString()} />) : localizedAlternates.length ? localizedAlternates.map(([code, href]) => <link rel="alternate" hreflang={code} href={new URL(href, siteConfig.siteUrl).toString()} />) : <link rel="alternate" hreflang={lang} href={canonical} />}
{isHome ? <link rel="alternate" hreflang="x-default" href={new URL('/it/', siteConfig.siteUrl).toString()} /> : localizedAlternates.length ? <link rel="alternate" hreflang="x-default" href={new URL(alternatePaths?.it || path, siteConfig.siteUrl).toString()} /> : alternateUrl && <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />}
{!isHome && !localizedAlternates.length && alternateUrl && <link rel="alternate" hreflang="x-default" href={lang === 'it' ? canonical : alternateUrl} />}
{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
