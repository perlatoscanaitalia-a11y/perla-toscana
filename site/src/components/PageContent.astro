---
import CTAButtons from './CTAButtons.astro';
import FAQBlock from './FAQBlock.astro';
import BookingCTA from './BookingCTA.astro';
import BookingPage from './BookingPage.astro';
import GalleryGrid from './GalleryGrid.astro';
import MapPinIcon from './MapPinIcon.astro';
import SocialLinks from './SocialLinks.astro';
import GuidesAndItineraries from './GuidesAndItineraries.astro';
import type { PageContent as Content, Lang } from '../data/pages';

interface Props {
  lang: Lang | 'de';
  page: Content;
}

const { lang, page } = Astro.props;
const hideSalesCtas = ['privacy-policy', 'cookie-policy', 'terms-and-conditions', 'legal-information'].includes(page.slug);
const isBookingPage = ['prenota', 'book'].includes(page.slug);
const initialsFor = (name: string) => name
  .replace(/[’']/g, ' ')
  .split(' ')
  .filter((word) => word && !['di', 'del', 'della', 'dei', 'of', 'the'].includes(word.toLowerCase()))
  .slice(0, 2)
  .map((word) => word[0])
  .join('');
---
{isBookingPage ? (
  <BookingPage lang={lang === 'de' ? 'en' : lang} />
) : (
<>
<section class="section page-hero">
  <div class="container page-hero-inner">
    {page.publishedAt && <nav class="breadcrumbs" aria-label={lang === 'it' ? 'Percorso di navigazione' : lang === 'de' ? 'Brotkrümelnavigation' : 'Breadcrumb'}><a href={`/${lang}/`}>Perla Toscana</a><span aria-hidden="true">/</span><a href={lang === 'it' ? '/it/guide/' : lang === 'de' ? '/de/reisefuehrer/' : '/en/guides/'}>{lang === 'it' ? 'Guide' : lang === 'de' ? 'Reiseführer' : 'Guides'}</a><span aria-hidden="true">/</span><span aria-current="page">{page.h1}</span></nav>}
    <p class="eyebrow">{page.eyebrow}</p>
    <h1>{page.h1}</h1>
    {(page.publishedAt || page.updatedAt) && (
      <p class="article-dates">
        {page.publishedAt && <span>{lang === 'it' ? 'Pubblicato' : lang === 'de' ? 'Veröffentlicht' : 'Published'}: <time datetime={page.publishedAt}>{new Date(page.publishedAt).toLocaleDateString(lang === 'it' ? 'it-IT' : lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></span>}
        {page.updatedAt && <span>{lang === 'it' ? 'Aggiornato' : lang === 'de' ? 'Aktualisiert' : 'Updated'}: <time datetime={page.updatedAt}>{new Date(page.updatedAt).toLocaleDateString(lang === 'it' ? 'it-IT' : lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></span>}
      </p>
    )}
    {page.introHeading && <h2 class="intro-heading">{page.introHeading}</h2>}
    <p class="lead" set:html={page.intro} />
    {!hideSalesCtas && <CTAButtons lang={lang} bookingPage={isBookingPage} />}
  </div>
</section>

{['brunello-di-montalcino-cantine-prezzi', 'brunello-di-montalcino-wineries-vintages-prices'].includes(page.slug) && (
  <section class="section article-feature-image">
    <div class="container">
      <img src="/images/places/montalcino/brunello-bottiglia-calice.webp" alt={lang === 'it' ? 'Bottiglia e calice di Brunello di Montalcino' : 'Bottle and glass of Brunello di Montalcino'} width="960" height="1200" loading="eager" decoding="async" />
    </div>
  </section>
)}

{['san-gimignano-cosa-vedere', 'san-gimignano-things-to-do-towers-parking'].includes(page.slug) && (
  <section class="section article-feature-image">
    <div class="container">
      <img src="/images/places/san-gimignano.webp" alt={lang === 'it' ? 'Torri medievali di San Gimignano nel paesaggio collinare della Toscana' : 'Medieval towers of San Gimignano above the rolling Tuscan countryside'} width="1280" height="899" loading="eager" decoding="async" />
    </div>
  </section>
)}

{['via-francigena-toscana-tappe-itinerario', 'via-francigena-tuscany-stages-itinerary'].includes(page.slug) && (
  <section class="section article-feature-image">
    <div class="container">
      <img src="/images/places/san-gimignano.webp" alt={lang === 'it' ? 'San Gimignano, tappa della Via Francigena tra le colline della Toscana' : 'San Gimignano on the Via Francigena among the Tuscan hills'} width="1280" height="899" loading="eager" decoding="async" />
    </div>
  </section>
)}

{['bagni-san-filippo-terme-libere', 'bagni-san-filippo-hot-springs'].includes(page.slug) && page.socialImage && (
  <section class="section article-feature-image">
    <div class="container">
      <img src={page.socialImage} alt={page.socialImageAlt ?? page.h1} width="1600" height="1200" loading="eager" fetchpriority="high" decoding="async" />
    </div>
  </section>
)}

{['borghi-toscani-poco-conosciuti', 'hidden-villages-tuscany', 'geheimtipps-toskana-doerfer'].includes(page.slug) && page.socialImage && (
  <section class="section article-feature-image">
    <div class="container">
      <img src={page.socialImage} alt={page.socialImageAlt ?? page.h1} width="1280" height="853" loading="eager" fetchpriority="high" decoding="async" />
    </div>
  </section>
)}

<section class="section">
  <div class="container content-stack">
    {page.sections.map((section) => (
      <article class:list={['card', section.variant && `card--${section.variant}`]} id={section.anchor}>
        {section.anchor === 'caseificio-cugusi' && (
          <picture class="cugusi-photo">
            <img
              src="/images/places/cugusi-pecorino-foglie-noce.png"
              alt="Pecorino di Pienza Cugusi stagionato sotto foglie di noce, con una fetta accanto alla forma"
              width="630"
              height="700"
              loading="lazy"
              decoding="async"
            />
          </picture>
        )}
        {section.anchor === 'caseificio-cugusi' && <p class="cugusi-caption">I pecorini del Caseificio Cugusi, una delle nostre scoperte durante una giornata a Pienza.</p>}
        {section.image && (
          <picture>
            {section.image.webpSrc && <source srcset={section.image.webpSrc} type="image/webp" />}
            <img
              class="section-image"
              src={section.image.src}
              alt={section.image.alt}
              width={section.image.width}
              height={section.image.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
        )}
        {section.caption && <p class="section-caption">{section.caption}</p>}
        <h2>{section.title}</h2>
        {section.html ? (
          <div class="section-html" set:html={section.html} />
        ) : (
          <p set:html={section.body ?? ''} />
        )}
        {section.attractions && (
          <div class="attraction-grid">
            {section.attractions.map((attraction) => (
              <article class="attraction-card">
                <div class="attraction-media" aria-hidden={attraction.image ? undefined : 'true'}>
                  {attraction.image ? (
                    <picture>
                      {attraction.image.webpSrc && <source srcset={attraction.image.webpSrc} type="image/webp" />}
                      <img
                        src={attraction.image.src}
                        alt={attraction.image.alt[lang]}
                        width={attraction.image.width}
                        height={attraction.image.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  ) : (
                    <span>{initialsFor(attraction.name)}</span>
                  )}
                </div>
                <h3>{attraction.name}</h3>
                {attraction.locality && <p class="attraction-locality">{attraction.locality}</p>}
                {attraction.badges && (
                  <ul class="attraction-badges">
                    {attraction.badges.map((badge) => <li>{badge}</li>)}
                  </ul>
                )}
                {attraction.categories && (
                  <ul class="attraction-tags">
                    {attraction.categories.map((category) => <li>{category}</li>)}
                  </ul>
                )}
                {attraction.distance && attraction.drivingTime && (
                  <p class="attraction-compact">
                    {attraction.distance} · {attraction.drivingTime} {lang === 'it' ? 'in auto' : 'by car'}
                  </p>
                )}
                {attraction.rating && (
                  <p class="attraction-rating">
                    {lang === 'it' ? 'Valutazione indicativa' : 'Indicative rating'}: {attraction.rating}
                    {attraction.ratingSource && ` · ${attraction.ratingSource}`}
                  </p>
                )}
                {attraction.cuisine && (
                  <p class="attraction-detail">
                    <strong>{lang === 'it' ? 'Tipo di cucina' : 'Cuisine'}:</strong> {attraction.cuisine}
                  </p>
                )}
                <p>{attraction.description}</p>
                {attraction.idealFor && <p class="attraction-ideal">{attraction.idealFor}</p>}
                {attraction.phone && attraction.phoneVerified && (
                  <p class="attraction-phone">
                    <strong>{lang === 'it' ? 'Telefono' : 'Phone'}:</strong> {attraction.phone}
                  </p>
                )}
                {attraction.note && <p class="attraction-note">{attraction.note}</p>}
                <div class="attraction-actions">
                  {attraction.phoneHref && attraction.phoneVerified && (
                    <a href={attraction.phoneHref}>{lang === 'it' ? 'Chiama' : 'Call'}</a>
                  )}
                  {attraction.whatsappHref && attraction.whatsappVerified && (
                    <a href={attraction.whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
                  )}
                  {attraction.directionsUrl && (
                    <a href={attraction.directionsUrl} target="_blank" rel="noopener noreferrer">{lang === 'it' ? 'Indicazioni' : 'Directions'}</a>
                  )}
                  {attraction.websiteUrl && (
                    <a href={attraction.websiteUrl} target="_blank" rel="noopener noreferrer">{lang === 'it' ? 'Sito ufficiale' : 'Official website'}</a>
                  )}
                  {attraction.tripadvisorUrl && (
                    <a href={attraction.tripadvisorUrl} target="_blank" rel="noopener noreferrer">{lang === 'it' ? 'Recensioni Tripadvisor' : 'Tripadvisor reviews'}</a>
                  )}
                  {attraction.profileUrl && (
                    <a href={attraction.profileUrl} target="_blank" rel="noopener noreferrer">{attraction.profileLabel || (lang === 'it' ? 'Vedi profilo' : 'View profile')}</a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
        {section.note && <p class="section-note">{section.note}</p>}
        {section.rules && (
          <ul class="rule-list">
            {section.rules.map((rule) => <li>{rule}</li>)}
          </ul>
        )}
        {section.links && (
          <div class="inline-links">
            {section.links.map((link) => (
              <a class:list={['inline-pill', link.external && 'inline-pill--map']} href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                {link.external && <MapPinIcon />}
                {link.label}
              </a>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

{(page.path.includes('/guide') || page.slug.includes('trasimeno')) && !['san-gimignano-cosa-vedere', 'san-gimignano-things-to-do-towers-parking'].includes(page.slug) && (
  <section class="section section--sand related-guide">
    <div class="container">
      <p class="eyebrow">{lang === 'it' ? 'Nuova guida consigliata' : 'Recommended local guide'}</p>
      <h2>{lang === 'it' ? 'San Gimignano: torri, parcheggi e itinerario' : 'San Gimignano: towers, parking and itinerary'}</h2>
      <p>{lang === 'it' ? 'Organizza una giornata nel borgo medievale con distanze, parcheggi aggiornati e un percorso a piedi realistico.' : 'Plan a day in the medieval town with distances, current parking information and a realistic walking route.'}</p>
      <a class="button button--secondary" href="/guide/san-gimignano-cosa-vedere/" aria-label={lang === 'it' ? 'Leggi la guida completa a San Gimignano' : 'Read the complete San Gimignano guide'}>{lang === 'it' ? 'Leggi la guida a San Gimignano' : 'Read the San Gimignano guide'}</a>
    </div>
  </section>
)}

{(page.path.includes('/guide') || page.slug.includes('trasimeno')) && !['via-francigena-toscana-tappe-itinerario', 'via-francigena-tuscany-stages-itinerary'].includes(page.slug) && (
  <section class="section related-guide">
    <div class="container">
      <p class="eyebrow">{lang === 'it' ? 'Cammini in Toscana' : 'Walking routes in Tuscany'}</p>
      <h2>{lang === 'it' ? 'Via Francigena: tutte le tappe toscane' : 'Via Francigena: all Tuscany stages'}</h2>
      <p>{lang === 'it' ? 'Scopri il percorso ufficiale, i borghi, la mappa e gli itinerari a piedi, in bici o in auto.' : 'Explore the official route, towns, map and practical walking, cycling or driving itineraries.'}</p>
      <a class="button button--secondary" href={lang === 'it' ? '/guide/via-francigena-toscana-tappe-itinerario/' : '/en/guides/via-francigena-tuscany-stages-itinerary/'}>{lang === 'it' ? 'Leggi la guida alla Via Francigena' : 'Read the Via Francigena guide'}</a>
    </div>
  </section>
)}

{['cosa-vedere-a-pienza','what-to-see-in-pienza','brunello-di-montalcino-cantine-prezzi','brunello-di-montalcino-wineries-vintages-prices','via-francigena-toscana-tappe-itinerario','via-francigena-tuscany-stages-itinerary','siena','abbazia-di-san-galgano','san-galgano-abbey'].includes(page.slug) && (
  <section class="section section--sand related-guide">
    <div class="container">
      <p class="eyebrow">{lang === 'it' ? 'Paesaggi UNESCO' : 'UNESCO landscapes'}</p>
      <h2>{lang === 'it' ? 'Guida completa alla Val d’Orcia' : 'Complete Val d’Orcia guide'}</h2>
      <p>{lang === 'it' ? 'Pienza, Montalcino, Bagno Vignoni, cipressi, parcheggi e itinerari realistici di uno, due o tre giorni.' : 'Pienza, Montalcino, Bagno Vignoni, cypresses, parking and realistic one-, two- and three-day itineraries.'}</p>
      <a class="button button--secondary" href={lang === 'it' ? '/guide/val-dorcia-cosa-vedere-itinerario/' : '/en/guides/val-dorcia-things-to-do-itinerary/'}>{lang === 'it' ? 'Leggi la guida alla Val d’Orcia' : 'Read the Val d’Orcia guide'}</a>
    </div>
  </section>
)}

{['contatti', 'contact'].includes(page.slug) && (
  <section class="section section--sand">
    <div class="container content-stack">
      <article class="card contact-social-card">
        <SocialLinks lang={lang} />
      </article>
    </div>
  </section>
)}

{page.slug.includes('galler') || page.slug === 'gallery' ? (
  <section class="section section--sand">
    <div class="container">
      <GalleryGrid lang={lang === 'de' ? 'en' : lang} />
    </div>
  </section>
) : null}

{page.propertyFaqs && (
  <section class="section section--sand property-faq-section">
    <div class="container faq-section">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>{lang === 'it' ? 'FAQ sulla struttura' : 'Property FAQs'}</h2>
      </div>
      <FAQBlock items={page.propertyFaqs} />
    </div>
  </section>
)}

{page.faqs && (
  <section class="section section--sand">
    <div class="container faq-section">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>{lang === 'it' ? 'Domande frequenti' : 'Frequently asked questions'}</h2>
      </div>
      <FAQBlock items={page.faqs} />
    </div>
  </section>
)}

{['cosa-fare', 'what-to-do'].includes(page.slug) && <GuidesAndItineraries lang={lang === 'de' ? 'en' : lang} />}

{!hideSalesCtas && !isBookingPage && <BookingCTA lang={lang} />}
</>
)}

<style>
  .page-hero {
    background: var(--color-sand);
  }
  .article-feature-image { padding-block: 28px 0; }
  .article-feature-image img { display:block; width:100%; max-height:520px; object-fit:cover; object-position:center 48%; border-radius:var(--radius); }
  .related-guide .container { display:grid; gap:14px; }
  .related-guide h2 { max-width:760px; }
  .related-guide p:not(.eyebrow) { max-width:720px; }
  .related-guide .button { width:fit-content; }

  .page-hero-inner,
  .content-stack,
  .faq-section {
    display: grid;
    gap: 22px;
  }

  .content-stack {
    max-width: 920px;
  }

  .property-faq-section + .section--sand {
    padding-top: 0;
  }

  .page-hero-inner > *,
  .content-stack > * {
    min-width: 0;
  }

  .intro-heading {
    margin-bottom: -10px;
    color: var(--color-terracotta-dark);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }

  .article-dates { display:flex; flex-wrap:wrap; gap:8px 18px; color:rgba(47,42,36,.7); font-size:.9rem; }
  .breadcrumbs { display:flex; flex-wrap:wrap; gap:6px; color:rgba(47,42,36,.68); font-size:.84rem; }
  .breadcrumbs a { color:var(--color-olive); }
  .section-html :global(.day-table) { width:100%; border-collapse:collapse; font-size:.94rem; }
  .section-html :global(.day-table th), .section-html :global(.day-table td) { padding:10px; border-bottom:1px solid var(--color-border); text-align:left; vertical-align:top; }
  .section-html :global(.day-table th) { color:var(--color-olive); }
  .section-html :global(.article-toc) { columns:2; padding-left:20px; }
  .section-html :global(.article-toc li) { margin:0 0 8px; break-inside:avoid; }
  .section-html :global(a) { color:var(--color-terracotta); }
  .section-html :global(.travel-facts) { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin:0 0 20px; }
  .section-html :global(.travel-facts div) { display:grid; gap:3px; padding:14px 10px; border:1px solid rgba(102,114,77,.22); border-radius:10px; background:rgba(255,255,255,.55); text-align:center; }
  .section-html :global(.travel-facts strong) { color:var(--color-terracotta-dark); font-size:1.05rem; }
  .section-html :global(.travel-facts span) { color:rgba(47,42,36,.72); font-size:.78rem; }

  .card h2 {
    margin-bottom: 12px;
  }

  .section-html {
    display: grid;
    gap: 16px;
  }

  .section-html h3 {
    color: var(--color-terracotta-dark);
    font-size: 1.08rem;
    margin-bottom: 6px;
  }

  .arrival-block {
    display: grid;
    gap: 6px;
  }

  .section-html p {
    margin: 0;
  }

  .card--callout {
    border: 1px solid rgba(166, 83, 50, 0.28);
    background:
      linear-gradient(180deg, rgba(255, 248, 240, 0.96), rgba(247, 233, 216, 0.96)),
      var(--color-warm-white);
    box-shadow: 0 12px 28px rgba(166, 83, 50, 0.08);
  }

  .card--callout h2 {
    color: var(--color-terracotta);
  }

  .card--callout p {
    color: rgba(47, 42, 36, 0.84);
  }

  .card[id] {
    scroll-margin-top: 96px;
  }

  .section-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: calc(var(--radius) - 2px);
    margin-bottom: 18px;
    object-fit: cover;
  }

  .section-caption {
    margin: -6px 0 0;
    font-size: 0.94rem;
    color: rgba(47, 42, 36, 0.72);
    font-style: italic;
  }

  #pozzone-loro-ciuffenna-agosto-2026 .section-image {
    aspect-ratio: 3 / 4;
    max-height: 760px;
    object-fit: contain;
    background: rgba(47, 42, 36, 0.04);
  }

  #caseificio-cugusi {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.2fr);
    grid-template-areas:
      "title title"
      "photo copy"
      "caption copy"
      "links links";
    column-gap: 28px;
    align-items: start;
  }

  #caseificio-cugusi > h2 { grid-area: title; }
  #caseificio-cugusi > .section-html { grid-area: copy; }
  #caseificio-cugusi > .inline-links { grid-area: links; }

  .cugusi-photo {
    grid-area: photo;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(var(--radius) - 2px);
    background: #fff;
  }

  .cugusi-photo img {
    display: block;
    width: 126%;
    max-width: none;
    height: auto;
    transform: translate(-10.3%, -16.6%);
  }

  .cugusi-caption {
    grid-area: caption;
    margin: 10px 0 0;
    color: rgba(47, 42, 36, 0.72);
    font-size: 0.9rem;
    font-style: italic;
  }

  .contact-social-card {
    background: var(--color-espresso);
    color: var(--color-warm-white);
  }

  .rule-list {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding-left: 22px;
  }

  .rule-list li {
    padding-left: 4px;
  }

  .attraction-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 20px;
  }

  .attraction-card {
    display: grid;
    align-content: start;
    gap: 10px;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) - 2px);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.68), rgba(251, 244, 232, 0.62)),
      rgba(251, 244, 232, 0.58);
    overflow: hidden;
    padding: 0 18px 18px;
  }

  .attraction-media {
    display: grid;
    min-height: 96px;
    place-items: center;
    margin-inline: -18px;
    background:
      radial-gradient(circle at 20% 24%, rgba(255, 255, 255, 0.5), transparent 28%),
      linear-gradient(135deg, rgba(102, 114, 77, 0.18), rgba(184, 142, 97, 0.22)),
      var(--color-sand);
  }

  .attraction-media img {
    width: 100%;
    height: 148px;
    object-fit: cover;
    object-position: center;
  }

  .attraction-media picture {
    width: 100%;
  }

  .attraction-media span {
    display: inline-grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border: 1px solid rgba(47, 42, 36, 0.18);
    border-radius: 50%;
    background: rgba(251, 244, 232, 0.78);
    color: var(--color-espresso);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .attraction-card h3 {
    color: var(--color-espresso);
  }

  .attraction-locality,
  .attraction-detail,
  .attraction-phone,
  .attraction-rating {
    color: rgba(47, 42, 36, 0.76);
    font-size: 0.92rem;
    line-height: 1.42;
  }

  .attraction-locality {
    color: var(--color-olive);
    font-weight: 800;
  }

  .attraction-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .attraction-tags li {
    border: 1px solid rgba(102, 114, 77, 0.18);
    border-radius: 999px;
    background: rgba(102, 114, 77, 0.08);
    color: var(--color-olive);
    font-size: 0.78rem;
