---
const guides = [
  { title: 'Bagni San Filippo: terme libere e Fosso Bianco', description: 'Guida 2026 a Fosso Bianco, Balena Bianca, regole per il bagno, accesso, parcheggi e itinerario.', href: '/guide/bagni-san-filippo-terme-libere/', image: '/images/places/val-d-orcia.jpg', alt: 'Paesaggio della Val d’Orcia vicino a Bagni San Filippo' },
  { title: 'Gli Etruschi nel Valdarno e a Figline', description: 'La Rotta, la tomba di Scampata, il ruolo dell’Arno e ciò che le fonti dimostrano davvero sulle cave antiche.', href: '/guide/etruschi-valdarno-figline/', image: '/images/places/balze-del-valdarno.webp', alt: 'Paesaggio delle Balze nel Valdarno Superiore' },
  { title: 'Via Francigena in Toscana', description: 'Tutte le 16 tappe, 394 km, mappa ufficiale, itinerari a piedi, in bici e in auto, credenziale e consigli pratici.', href: '/guide/via-francigena-toscana-tappe-itinerario/', image: '/images/places/san-gimignano.webp', alt: 'San Gimignano, tappa della Via Francigena tra le colline della Toscana' },
  { title: 'Brunello di Montalcino: cantine, annate e prezzi', description: 'Disciplinare, migliori annate, vini premiati, prezzi verificati, cantine visitabili e itinerario da Perla Toscana.', href: '/guide/brunello-di-montalcino-cantine-prezzi/', image: '/images/places/montalcino/vigneti-brunello.webp', alt: 'Vigneti di Brunello di Montalcino sulle colline toscane' },
  { title: 'Lago Trasimeno: cosa vedere, borghi e isole', description: 'Castiglione del Lago, Passignano, Isola Maggiore, traghetti e itinerari pratici da Perla Toscana.', href: '/lago-trasimeno-cosa-vedere/', image: '/images/places/lago-trasimeno/lago-trasimeno-panorama.webp', alt: 'Panorama del Lago Trasimeno visto da Castiglione del Lago' },
  { title: 'Luoghi francescani tra Toscana e Umbria', description: 'La Verna, Cortona, Trasimeno e Assisi con distanze, consigli pratici e itinerari di 3, 5 e 7 giorni.', href: '/it/guide/luoghi-francescani-toscana-umbria/', image: '/images/places/santuario-la-verna.webp', alt: 'Santuario della Verna tra i boschi, tappa dell’itinerario francescano fra Toscana e Umbria', position: 'center 42%' },
  { title: 'Abbazia di San Galgano', description: 'Abbazia senza tetto, Eremo di Montesiepi, spada nella roccia e consigli pratici per organizzare una gita di un giorno.', href: '/it/guide/abbazia-di-san-galgano/', image: '/images/places/san-galgano/san-galgano-abbey-exterior.webp', alt: 'Abbazia di San Galgano senza tetto nella campagna di Chiusdino' },
  { title: 'Cosa vedere a Pienza in un giorno', description: 'Centro storico rinascimentale, panorami della Val d’Orcia, pecorino e un itinerario pratico per l’intera giornata.', href: '/it/guide/cosa-vedere-a-pienza/', image: '/images/places/pienza-piazza-pio-ii.webp', alt: 'Piazza Pio II nel centro storico rinascimentale di Pienza' },
  { title: 'Visitare Firenze in un giorno', description: 'Itinerario pratico da Figline Valdarno con treno, parcheggi, ZTL, tappe a piedi, prenotazioni e consigli per famiglie.', href: '/it/guide/firenze-in-un-giorno/', image: '/images/places/duomo-firenze-facciata.webp', alt: 'Dettaglio esterno del Duomo di Firenze, Cattedrale di Santa Maria del Fiore' },
  { title: 'Cosa vedere a Figline Valdarno', description: 'Centro storico, itinerario, stazione, parcheggi e consigli per scoprire la località più vicina alla casa.', href: '/guide/cosa-vedere-figline-valdarno/', image: '/images/places/figline-piazza-marsilio-ficino.webp', alt: 'Piazza Marsilio Ficino nel centro storico di Figline Valdarno' },
  { title: 'Dove dormire vicino a The Mall Firenze', description: 'Zone, hotel, appartamenti, trasporti e criteri pratici per scegliere l’alloggio giusto.', href: '/guide/dove-dormire-vicino-the-mall-firenze/', image: '/images/places/the-mall-firenze.webp', alt: 'Ingresso del centro commerciale The Mall Firenze a Leccio' },
  { title: 'Dove fermarsi tra Roma e Milano', description: 'Una sosta pratica nel Valdarno per spezzare il viaggio lungo la A1 vicino a Firenze.', href: '/guide/dove-fermarsi-lungo-a1-tra-roma-e-milano/', image: '/images/places/autostrada-a1-valdarno.webp', alt: 'Autostrada A1 nel tratto Firenze–Roma presso l’uscita Valdarno', position: 'center 58%' },
  { title: 'Firenze in 1 giorno', description: 'Una guida pratica per organizzare una giornata tra monumenti, musei e quartieri di Firenze.', href: '/it/guide/firenze/', image: '/images/places/firenze-centro.jpg', alt: 'Veduta del centro storico di Firenze' },
  { title: 'The Mall Firenze', description: 'Come organizzare una visita all’outlet e abbinarla alle destinazioni vicine.', href: '/it/guide/the-mall-firenze/', image: '/images/places/the-mall-firenze-facciata.webp', alt: 'Facciata di The Mall Firenze a Leccio' },
  { title: 'Chianti', description: 'Borghi, strade panoramiche e consigli per una giornata nel cuore del Chianti.', href: '/it/guide/chianti/', image: '/images/places/greve-in-chianti.jpg', alt: 'Piazza Matteotti nel borgo di Greve in Chianti' },
  { title: 'Valdarno', description: 'Borghi, Balze, sentieri e paesaggi tra Firenze e Arezzo.', href: '/it/guide/valdarno/', image: '/images/places/balze-del-valdarno.webp', alt: 'Le formazioni rocciose delle Balze del Valdarno tra campi e vegetazione', position: 'center 48%' },
  { title: 'Arezzo', description: 'Piazza Grande, centro storico, arte e antiquariato per una gita in giornata.', href: '/it/guide/arezzo/', image: '/images/places/arezzo-piazza-grande.webp', alt: 'Piazza Grande ad Arezzo con la Pieve di Santa Maria e il Palazzo della Fraternità', position: 'center 55%' },
  { title: 'Siena', description: 'Una guida essenziale alla città medievale, da Piazza del Campo al Duomo.', href: '/it/guide/siena/', image: '/images/places/siena.jpg', alt: 'Piazza del Campo e la Torre del Mangia a Siena' },
  { title: 'Reggello e Vallombrosa', description: 'Abbazia, foresta e sentieri per una giornata nella natura del Pratomagno.', href: '/it/guide/reggello-vallombrosa/', image: '/images/places/abbazia-vallombrosa.webp', alt: 'Abbazia di Vallombrosa riflessa nella vasca davanti al complesso religioso', position: 'center 46%' },
  { title: 'San Gimignano', description: 'Torri medievali, parcheggi 2026, musei, itinerari a piedi e consigli pratici per mezza giornata o un giorno.', href: '/guide/san-gimignano-cosa-vedere/', image: '/images/places/san-gimignano.webp', alt: 'Torri medievali di San Gimignano nel paesaggio collinare della Toscana' },
  { title: 'Val d’Orcia', description: 'Borghi, cipressi, terme, vino, parcheggi e itinerari realistici di 1, 2 o 3 giorni nella Toscana UNESCO.', href: '/guide/val-dorcia-cosa-vedere-itinerario/', image: '/images/places/pienza-val-d-orcia-panorama.webp', alt: 'Panorama della Val d’Orcia con Pienza e le colline toscane' },
  { title: 'Itinerario di 1 giorno', description: 'Un programma realistico per scoprire la Toscana partendo da Perla Toscana.', href: '/it/itinerari/1-giorno/', image: '/images/perla-toscana/perla-toscana-strada-setteponti.webp', alt: 'Strada panoramica della Setteponti tra le colline del Valdarno' },
  { title: 'Itinerario di 2 giorni', description: 'Due giornate tra città d’arte, paesaggi e destinazioni ben collegate.', href: '/it/itinerari/2-giorni/', image: '/images/places/pienza-val-d-orcia-panorama.webp', alt: 'Panorama della Val d’Orcia osservato dal borgo di Pienza', position: 'center 48%' },
  { title: 'Itinerario di 3 giorni', description: 'Tre giornate per alternare Firenze, Chianti, Valdarno e altre mete toscane.', href: '/it/itinerari/3-giorni/', image: '/images/places/montefioralle-chianti-panorama.webp', alt: 'Borgo di Montefioralle tra vigneti e colline del Chianti', position: 'center 52%' }
];
const cardMeta: Record<string, { category: string; distanceKm: number; distanceMinutes: number; visitTime: string; featuredBadge?: string }> = {
  'Gli Etruschi nel Valdarno e a Figline': { category: '🏺 Archeologia', distanceKm: 4, distanceMinutes: 8, visitTime: 'Guida culturale', featuredBadge: 'Nuova guida' },
  'Via Francigena in Toscana': { category: '🥾 Cammino', distanceKm: 62, distanceMinutes: 70, visitTime: '1–16 giorni', featuredBadge: '⭐ Consigliata' },
  'Brunello di Montalcino: cantine, annate e prezzi': { category: '🍷 Vino', distanceKm: 112, distanceMinutes: 105, visitTime: '1 giorno', featuredBadge: '⭐ Consigliata' },
  'Lago Trasimeno: cosa vedere, borghi e isole': { category: '🏞 Panorama', distanceKm: 85, distanceMinutes: 80, visitTime: '1 giorno' },
  'Luoghi francescani tra Toscana e Umbria': { category: '⛪ Abbazia', distanceKm: 68, distanceMinutes: 75, visitTime: 'Weekend' },
  'Abbazia di San Galgano': { category: '⛪ Abbazia', distanceKm: 105, distanceMinutes: 100, visitTime: '1 giorno' },
  'Cosa vedere a Pienza in un giorno': { category: '🏰 Borgo', distanceKm: 96, distanceMinutes: 95, visitTime: '1 giorno', featuredBadge: '❤️ Preferita dagli ospiti' },
  'Visitare Firenze in un giorno': { category: '🏰 Città d’arte', distanceKm: 38, distanceMinutes: 45, visitTime: '1 giorno', featuredBadge: '🔥 Più visitata' },
  'Cosa vedere a Figline Valdarno': { category: '🏰 Borgo', distanceKm: 4, distanceMinutes: 8, visitTime: 'Mezza giornata' },
  'Dove dormire vicino a The Mall Firenze': { category: '🛍 Shopping', distanceKm: 18, distanceMinutes: 25, visitTime: 'Mezza giornata' },
  'Dove fermarsi tra Roma e Milano': { category: '🚗 Itinerario', distanceKm: 8, distanceMinutes: 10, visitTime: '2 ore' },
  'Firenze in 1 giorno': { category: '🏰 Città d’arte', distanceKm: 38, distanceMinutes: 45, visitTime: '1 giorno' },
  'The Mall Firenze': { category: '🛍 Shopping', distanceKm: 18, distanceMinutes: 25, visitTime: 'Mezza giornata' },
  'Chianti': { category: '🍷 Vino', distanceKm: 32, distanceMinutes: 40, visitTime: '1 giorno' },
  'Valdarno': { category: '🌳 Natura', distanceKm: 20, distanceMinutes: 25, visitTime: '1 giorno' },
  'Arezzo': { category: '🏰 Città d’arte', distanceKm: 52, distanceMinutes: 50, visitTime: '1 giorno' },
  'Siena': { category: '🏰 Città d’arte', distanceKm: 75, distanceMinutes: 70, visitTime: '1 giorno' },
  'Reggello e Vallombrosa': { category: '🌳 Natura', distanceKm: 28, distanceMinutes: 40, visitTime: '1 giorno' },
  'San Gimignano': { category: '🏰 Borgo', distanceKm: 62, distanceMinutes: 70, visitTime: '1 giorno', featuredBadge: '⭐ Consigliata' },
  'Val d’Orcia': { category: '🌿 Paesaggio UNESCO', distanceKm: 96, distanceMinutes: 95, visitTime: '1–3 giorni', featuredBadge: '⭐ Guida completa' },
  'Itinerario di 1 giorno': { category: '🚗 Itinerario', distanceKm: 0, distanceMinutes: 0, visitTime: '1 giorno' },
  'Itinerario di 2 giorni': { category: '🚗 Itinerario', distanceKm: 0, distanceMinutes: 0, visitTime: 'Weekend' },
  'Itinerario di 3 giorni': { category: '🚗 Itinerario', distanceKm: 0, distanceMinutes: 0, visitTime: 'Weekend' }
};
---
<div class="guide-grid">
  {guides.map((guide) => (
    <article class:list={['guide-card', !guide.href && 'guide-card--pending']}>
      <img src={guide.image} alt={guide.alt ?? guide.title} width="1200" height="800" loading="lazy" decoding="async" style={guide.position ? `object-position:${guide.position}` : undefined} />
      <div class="guide-card__body">
        <div class="card-badges"><span class="category-badge">{cardMeta[guide.title]?.category ?? (guide.href ? '📍 Destinazione' : '🏞 Nuova meta')}</span>{cardMeta[guide.title]?.featuredBadge && <span class="featured-badge">{cardMeta[guide.title].featuredBadge}</span>}{!guide.href && <span class="pending-label">Prossimamente</span>}</div>
        <h2>{guide.title}</h2>
        {guide.href && <div class="card-details"><span>🚗 {cardMeta[guide.title]?.distanceKm === 0 ? 'Partenza da Perla Toscana' : `${cardMeta[guide.title]?.distanceKm ?? '—'} km • ${cardMeta[guide.title]?.distanceMinutes ?? '—'} min da Perla Toscana`}</span><span>🕒 Visita consigliata: {cardMeta[guide.title]?.visitTime ?? '1 giorno'}</span></div>}
        <p>{guide.description}</p>
        {guide.href && <a class="button button--secondary" href={guide.href} aria-label={`Leggi la guida: ${guide.title}`}>Leggi la guida</a>}
      </div>
    </article>
  ))}
</div>
<style>
.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.guide-card{display:grid;min-width:0;overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-warm-white);box-shadow:var(--shadow-soft)}.guide-card img{width:100%;height:174px;object-fit:cover}.guide-card__body{display:grid;align-content:start;gap:13px;padding:22px}.guide-card h2{font-size:clamp(1.45rem,2.4vw,1.85rem);overflow-wrap:anywhere}.guide-card p{color:rgba(47,42,36,.76);font-size:.94rem;line-height:1.5}.guide-card .button{align-self:end;min-height:46px;width:fit-content;margin-top:auto}.guide-card--pending{background:linear-gradient(180deg,var(--color-warm-white),rgba(247,241,232,.72))}.card-badges{display:flex;flex-wrap:wrap;gap:7px;align-items:center}.category-badge,.featured-badge,.pending-label{width:fit-content;border-radius:999px;font-size:.72rem;font-weight:800;line-height:1.25;padding:5px 9px}.category-badge{border:1px solid rgba(102,114,77,.22);background:rgba(102,114,77,.09);color:var(--color-olive)}.featured-badge{border:1px solid rgba(174,89,57,.2);background:rgba(174,89,57,.09);color:var(--color-terracotta-dark)}.pending-label{border:1px solid rgba(47,42,36,.14);background:rgba(47,42,36,.06);color:rgba(47,42,36,.72);cursor:default}.card-details{display:grid;gap:3px;color:rgba(47,42,36,.78);font-size:.8rem;font-weight:700;line-height:1.4}@media(max-width:920px){.guide-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.guide-grid{grid-template-columns:1fr}.guide-card img{height:190px}.guide-card .button{width:100%;text-align:center}}
</style>
