---
import { photoCredits } from '../data/photoCredits';

interface Props { lang: 'it' | 'en'; }
const { lang } = Astro.props;
---
<section class="section credits-hero">
  <div class="container">
    <p class="eyebrow">{lang === 'it' ? 'Trasparenza' : 'Transparency'}</p>
    <h1>{lang === 'it' ? 'Crediti fotografici' : 'Photo credits'}</h1>
    <p class="lead">{lang === 'it' ? 'Autori, fonti e licenze delle fotografie riutilizzabili presenti nelle Guide di Perla Toscana.' : 'Authors, sources and licences for the reusable photographs featured in Perla Toscana’s Guides.'}</p>
  </div>
</section>
<section class="section">
  <div class="container credits-grid">
    {photoCredits.map((credit) => (
      <article class="credit-card">
        <h2>{credit.title}</h2>
        <dl>
          <div><dt>{lang === 'it' ? 'File locale' : 'Local file'}</dt><dd>{credit.file}</dd></div>
          <div><dt>{lang === 'it' ? 'Autore' : 'Author'}</dt><dd>{credit.author}</dd></div>
          <div><dt>{lang === 'it' ? 'Fonte' : 'Source'}</dt><dd><a href={credit.source} target="_blank" rel="noopener noreferrer">Wikimedia Commons</a></dd></div>
          <div><dt>{lang === 'it' ? 'Licenza' : 'Licence'}</dt><dd><a href={credit.licenseUrl} target="_blank" rel="noopener noreferrer">{credit.license}</a></dd></div>
        </dl>
      </article>
    ))}
  </div>
</section>
<style>
  .credits-hero{background:var(--color-sand)}
  .credits-hero .container{display:grid;gap:18px}
  .credits-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .credit-card{min-width:0;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-warm-white);box-shadow:var(--shadow-soft);padding:22px}
  .credit-card h2{margin-bottom:16px;font-size:1.22rem;overflow-wrap:anywhere}
  .credit-card dl,.credit-card dl div{display:grid;gap:5px}.credit-card dl{gap:12px}
  .credit-card dt{color:var(--color-olive);font-size:.78rem;font-weight:800;text-transform:uppercase}
  .credit-card dd{margin:0;overflow-wrap:anywhere}.credit-card a{color:var(--color-terracotta)}
  @media(max-width:680px){.credits-grid{grid-template-columns:1fr}.credit-card{padding:18px}}
</style>
