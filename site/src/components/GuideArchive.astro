import type { Lang, PageContent } from '../data/pages';
interface Props { lang: Lang; }
type CardItem = Pick<PageContent, 'slug' | 'path' | 'h1' | 'description'> & Partial<Pick<PageContent, 'socialImageAlt' | 'category' | 'distanceKm' | 'distanceMinutes' | 'visitTime' | 'featuredBadge'>>;
const { lang } = Astro.props;
const specialCards: CardItem[] = lang === 'it' ? [
  { slug:'sosta-a1',path:'/guide/dove-fermarsi-lungo-a1-tra-roma-e-milano/',h1:'Dove fermarsi lungo la A1 tra Roma e Milano',description:'Una guida per spezzare il viaggio vicino Firenze, con parcheggio comodo e spazio per famiglie e gruppi.',category:'🚗 Itinerario',distanceKm:8,distanceMinutes:10,visitTime:'2 ore' },
