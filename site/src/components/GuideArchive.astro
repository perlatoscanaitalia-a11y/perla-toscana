  { slug:'etruscans-valdarno-figline',path:'/en/guides/etruscans-valdarno-figline/',h1:'The Etruscans in Valdarno and Figline',description:'La Rotta, the Scampata tomb, the Arno corridor and what archaeological evidence really tells us.',category:'🏺 Archaeology',distanceKm:4,distanceMinutes:8,visitTime:'Cultural guide',featuredBadge:'⭐ Recommended' },
  { slug:'figline-speciale',path:'/en/guides/figline-valdarno/',h1:'What to see in Figline Valdarno',description:'Historic centre, walking route, parking, trains to Florence and local tips.',category:'🏰 Village',distanceKm:4,distanceMinutes:8,visitTime:'Half day' }
];
const local: CardItem[] = (lang === 'it' ? [bagniSanFilippoPage, valDorciaPage, viaFrancigenaPage, sanGimignanoPage, ...specialCards, brunelloPage, lakeTrasimenoPage, ...guides.it] : [bagniSanFilippoPageEn, valDorciaPageEn, viaFrancigenaPageEn, sanGimignanoPageEn, ...specialCards, brunelloPageEn, lakeTrasimenoPageEn, ...guides.en])
  .filter((item) => item.slug !== 'figline-valdarno' && (['lago-trasimeno-cosa-vedere', 'lake-trasimeno-what-to-see'].includes(item.slug) || item.path.includes(lang === 'it' ? '/guide/' : '/guides/')));
const itineraries = guides[lang].filter((item) => item.path.includes(lang === 'it' ? '/itinerari/' : '/itineraries/'));
