---
import { guides } from '../data/guides';
import { lakeTrasimenoPage } from '../data/guideLakeTrasimeno';
import { lakeTrasimenoPageEn } from '../data/guideLakeTrasimenoEn';
import { brunelloPage } from '../data/guideBrunello';
import type { Lang } from '../data/pages';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const local = (lang === 'it' ? [brunelloPage, lakeTrasimenoPage, ...guides[lang]] : [lakeTrasimenoPageEn, ...guides[lang]])
  .filter((item) => item.slug !== 'figline-valdarno' && (['lago-trasimeno-cosa-vedere', 'lake-trasimeno-what-to-see'].includes(item.slug) || item.path.includes(lang === 'it' ? '/guide/' : '/guides/')))
  .map((item) => ['abbazia-di-san-galgano', 'san-galgano-abbey'].includes(item.slug) ? {
    ...item,
    h1: lang === 'it' ? 'Abbazia di San Galgano' : 'San Galgano Abbey',
    description: lang === 'it'
      ? 'Abbazia senza tetto, Eremo di Montesiepi, spada nella roccia e consigli pratici per una gita di un giorno.'
      : 'The roofless abbey, Montesiepi Hermitage, the sword in the stone and practical advice for a full-day trip.'
  } : item);
const itineraries = guides[lang].filter((item) => item.path.includes(lang === 'it' ? '/itinerari/' : '/itineraries/'));
const images: Record<string,string> = {
  'brunello-di-montalcino-cantine-prezzi':'/images/places/montalcino/vigneti-brunello.webp',
  'lago-trasimeno-cosa-vedere':'/images/places/lago-trasimeno/lago-trasimeno-panorama.webp',
  'lake-trasimeno-what-to-see':'/images/places/lago-trasimeno/lago-trasimeno-panorama.webp',
  'luoghi-francescani-toscana-umbria':'/images/places/santuario-la-verna.webp','franciscan-places-tuscany-umbria':'/images/places/santuario-la-verna.webp',
  'abbazia-di-san-galgano':'/images/places/san-galgano/san-galgano-abbey-exterior.webp','san-galgano-abbey':'/images/places/san-galgano/san-galgano-abbey-exterior.webp',
  'cosa-vedere-a-pienza':'/images/places/pienza-piazza-pio-ii.webp','what-to-see-in-pienza':'/images/places/pienza-piazza-pio-ii.webp',
  'firenze-in-un-giorno':'/images/perla-toscana/perla-toscana-tavolo-pranzo-apparecchiato.jpg','florence-in-one-day':'/images/perla-toscana/perla-toscana-tavolo-pranzo-apparecchiato.jpg',
  firenze:'/images/places/firenze-centro.jpg',florence:'/images/places/firenze-centro.jpg',chianti:'/images/places/greve-in-chianti.jpg','the-mall-firenze':'/images/places/the-mall-firenze.webp','figline-valdarno':'/images/perla-toscana/perla-toscana-soggiorno-cucina-figline-valdarno.jpg',valdarno:'/images/places/balze-del-valdarno.webp',arezzo:'/images/places/arezzo-piazza-grande.webp',siena:'/images/places/siena.jpg','reggello-vallombrosa':'/images/places/abbazia-vallombrosa.webp','1-giorno':'/images/places/san-gimignano.jpg','1-day':'/images/places/san-gimignano.jpg','2-giorni':'/images/places/val-d-orcia.jpg','2-days':'/images/places/val-d-orcia.jpg','3-giorni':'/images/places/montefioralle-chianti-panorama.webp','3-days':'/images/places/montefioralle-chianti-panorama.webp'
};
const imageAlts: Record<string,Record<'it'|'en',string>> = {
  'brunello-di-montalcino-cantine-prezzi': { it: 'Vigneti di Brunello di Montalcino sulle colline toscane', en: 'Brunello di Montalcino vineyards in Tuscany' },
  'lago-trasimeno-cosa-vedere': { it: 'Panorama del Lago Trasimeno visto da Castiglione del Lago', en: 'Lake Trasimeno panorama from Castiglione del Lago' },
  'lake-trasimeno-what-to-see': { it: 'Panorama del Lago Trasimeno visto da Castiglione del Lago', en: 'Lake Trasimeno panorama from Castiglione del Lago' },
  'luoghi-francescani-toscana-umbria': { it: 'Santuario della Verna tra i boschi, tappa dell’itinerario francescano fra Toscana e Umbria', en: 'La Verna Sanctuary in the forest on a Franciscan itinerary through Tuscany and Umbria' },
  'franciscan-places-tuscany-umbria': { it: 'Santuario della Verna tra i boschi, tappa dell’itinerario francescano fra Toscana e Umbria', en: 'La Verna Sanctuary in the forest on a Franciscan itinerary through Tuscany and Umbria' },
  'abbazia-di-san-galgano': { it: 'Abbazia di San Galgano senza tetto nella campagna di Chiusdino', en: 'Roofless San Galgano Abbey in the countryside near Chiusdino' },
  'san-galgano-abbey': { it: 'Abbazia di San Galgano senza tetto nella campagna di Chiusdino', en: 'Roofless San Galgano Abbey in the countryside near Chiusdino' },
  'cosa-vedere-a-pienza': { it: 'Piazza Pio II nel centro storico rinascimentale di Pienza', en: 'Piazza Pio II in Pienza’s Renaissance historic centre' },
  'what-to-see-in-pienza': { it: 'Piazza Pio II nel centro storico rinascimentale di Pienza', en: 'Piazza Pio II in Pienza’s Renaissance historic centre' },
  'firenze-in-un-giorno': { it: 'Sala da pranzo di Perla Toscana, punto di partenza per Firenze', en: 'Perla Toscana dining room, the starting point for Florence' },
  'florence-in-one-day': { it: 'Sala da pranzo di Perla Toscana, punto di partenza per Firenze', en: 'Perla Toscana dining room, the starting point for Florence' },
  firenze: { it: 'Veduta del centro storico di Firenze', en: 'View of Florence historic centre' },
  florence: { it: 'Veduta del centro storico di Firenze', en: 'View of Florence historic centre' },
  chianti: { it: 'Piazza Matteotti nel borgo di Greve in Chianti', en: 'Piazza Matteotti in the village of Greve in Chianti' },
  'the-mall-firenze': { it: 'Ingresso del centro commerciale The Mall Firenze a Leccio', en: 'Entrance to The Mall Firenze shopping centre in Leccio' },
  'figline-valdarno': { it: 'Interno di Perla Toscana a Figline Valdarno', en: 'Interior of Perla Toscana in Figline Valdarno' },
  valdarno: { it: 'Le formazioni rocciose delle Balze del Valdarno tra campi e vegetazione', en: 'The Balze del Valdarno rock formations among fields and vegetation' },
  arezzo: { it: 'Piazza Grande ad Arezzo con la Pieve di Santa Maria e il Palazzo della Fraternità', en: 'Piazza Grande in Arezzo with Santa Maria parish church and Palazzo della Fraternità' },
  siena: { it: 'Piazza del Campo e la Torre del Mangia a Siena', en: 'Piazza del Campo and Torre del Mangia in Siena' },
  'reggello-vallombrosa': { it: 'Abbazia di Vallombrosa riflessa nella vasca davanti al complesso religioso', en: 'Vallombrosa Abbey reflected in the pool in front of the religious complex' },
  '1-giorno': { it: 'Torri medievali di San Gimignano per l’itinerario di un giorno', en: 'Medieval towers of San Gimignano for the one-day itinerary' },
  '1-day': { it: 'Torri medievali di San Gimignano per l’itinerario di un giorno', en: 'Medieval towers of San Gimignano for the one-day itinerary' },
  '2-giorni': { it: 'Colline della Val d’Orcia per l’itinerario di due giorni', en: 'Val d’Orcia hills for the two-day itinerary' },
  '2-days': { it: 'Colline della Val d’Orcia per l’itinerario di due giorni', en: 'Val d’Orcia hills for the two-day itinerary' },
  '3-giorni': { it: 'Borgo di Montefioralle tra vigneti e colline del Chianti per l’itinerario di tre giorni', en: 'Montefioralle village among Chianti vineyards and hills for the three-day itinerary' },
  '3-days': { it: 'Borgo di Montefioralle tra vigneti e colline del Chianti per l’itinerario di tre giorni', en: 'Montefioralle village among Chianti vineyards and hills for the three-day itinerary' }
};
const imagePositions: Record<string,string> = { valdarno: 'center 48%', arezzo: 'center 55%', 'reggello-vallombrosa': 'center 46%', '3-giorni': 'center 52%', '3-days': 'center 52%' };
const label = lang === 'it' ? 'Leggi la guida' : 'Read the guide';
---
<div class="archive-stack">
  {lang === 'it' && <section class="archive-group"><h2>Viaggi e soste</h2><div class="archive-grid"><a class="archive-card" href="/guide/dove-fermarsi-lungo-a1-tra-roma-e-milano/"><img src="/images/places/autostrada-a1-valdarno.webp" alt="Autostrada A1 nel tratto Firenze–Roma presso l’uscita Valdarno" width="1200" height="800" loading="lazy" style="object-position:center 58%"/><span>Viaggi e soste</span><h3>Dove fermarsi lungo la A1 tra Roma e Milano</h3><p>Una guida per spezzare il viaggio vicino Firenze, con parcheggio comodo e spazio per famiglie, gruppi e trasferte di lavoro.</p><strong>{label}</strong></a></div></section>}
  <section class="archive-group"><h2>{lang === 'it' ? 'Città, borghi e destinazioni' : 'Cities, villages and destinations'}</h2><div class="archive-grid"><a class="archive-card" href={lang === 'it' ? '/guide/cosa-vedere-figline-valdarno/' : '/en/guides/figline-valdarno/'}><img src="/images/places/figline-piazza-marsilio-ficino.webp" alt={lang === 'it' ? 'Piazza Marsilio Ficino nel centro storico di Figline Valdarno' : 'Piazza Marsilio Ficino in Figline Valdarno historic centre'} width="1600" height="1200" loading="lazy"/><span>{lang === 'it' ? 'Guida locale' : 'Local guide'}</span><h3>{lang === 'it' ? 'Cosa vedere a Figline Valdarno' : 'What to see in Figline Valdarno'}</h3><p>{lang === 'it' ? 'Centro storico, itinerario a piedi, parcheggi, treno per Firenze e consigli locali.' : 'Historic centre, walking route, parking, trains to Florence and local tips.'}</p><strong>{label}</strong></a>{local.map((item) => <a class="archive-card" href={item.path}><img src={images[item.slug]} alt={imageAlts[item.slug]?.[lang] ?? item.h1} width="1200" height="800" loading="lazy" style={imagePositions[item.slug] ? `object-position:${imagePositions[item.slug]}` : undefined}/><span>{lang === 'it' ? 'Destinazioni' : 'Destinations'}</span><h3>{item.h1}</h3><p>{item.description}</p><strong>{label}</strong></a>)}</div></section>
  <section class="archive-group"><h2>{lang === 'it' ? 'Itinerari' : 'Itineraries'}</h2><div class="archive-grid">{itineraries.map((item) => <a class="archive-card" href={item.path}><img src={images[item.slug]} alt={imageAlts[item.slug]?.[lang] ?? item.h1} width="1200" height="800" loading="lazy" style={imagePositions[item.slug] ? `object-position:${imagePositions[item.slug]}` : undefined}/><span>{lang === 'it' ? 'Itinerario' : 'Itinerary'}</span><h3>{item.h1}</h3><p>{item.description}</p><strong>{label}</strong></a>)}</div></section>
</div>
<style>
.archive-stack,.archive-group{display:grid;gap:22px}.archive-stack{gap:48px}.archive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.archive-card{display:grid;min-width:0;gap:11px;overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-warm-white);box-shadow:var(--shadow-soft);color:var(--color-espresso);padding:0 22px 22px;text-decoration:none;transition:transform 180ms ease,box-shadow 180ms ease}.archive-card:hover,.archive-card:focus-visible{transform:translateY(-3px);box-shadow:0 16px 34px rgba(47,42,36,.13)}.archive-card img{width:calc(100% + 44px);height:172px;margin:0 -22px;object-fit:cover}.archive-card span{color:var(--color-olive);font-size:.76rem;font-weight:800;text-transform:uppercase}.archive-card p{color:rgba(47,42,36,.76);font-size:.92rem;line-height:1.5}.archive-card strong{align-self:end;color:var(--color-terracotta);margin-top:auto}@media(max-width:920px){.archive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.archive-grid{grid-template-columns:1fr}.archive-stack{gap:38px}}
</style>
