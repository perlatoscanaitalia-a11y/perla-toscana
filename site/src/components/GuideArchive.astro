  'firenze-in-un-giorno':'/images/places/duomo-firenze-facciata.webp','florence-in-one-day':'/images/places/duomo-firenze-facciata.webp',
  firenze:'/images/places/firenze-centro.jpg',florence:'/images/places/firenze-centro.jpg',chianti:'/images/places/greve-in-chianti.jpg','the-mall-firenze':'/images/places/the-mall-firenze.webp',valdarno:'/images/places/balze-del-valdarno.webp',arezzo:'/images/places/arezzo-piazza-grande.webp',siena:'/images/places/siena.jpg','reggello-vallombrosa':'/images/places/abbazia-vallombrosa.webp','1-giorno':'/images/places/san-gimignano.jpg','1-day':'/images/places/san-gimignano.jpg','2-giorni':'/images/places/val-d-orcia.jpg','2-days':'/images/places/val-d-orcia.jpg','3-giorni':'/images/places/montefioralle-chianti-panorama.webp','3-days':'/images/places/montefioralle-chianti-panorama.webp'
};
