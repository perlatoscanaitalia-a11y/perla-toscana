  'brunello-di-montalcino-cantine-prezzi':{it:'Vigneti di Brunello di Montalcino sulle colline toscane',en:'Brunello di Montalcino vineyards in the Tuscan hills'},'brunello-di-montalcino-wineries-vintages-prices':{it:'Vigneti di Brunello di Montalcino sulle colline toscane',en:'Brunello di Montalcino vineyards in the Tuscan hills'},
  'lago-trasimeno-cosa-vedere':{it:'Panorama del Lago Trasimeno visto da Castiglione del Lago',en:'Lake Trasimeno panorama from Castiglione del Lago'},'lake-trasimeno-what-to-see':{it:'Panorama del Lago Trasimeno visto da Castiglione del Lago',en:'Lake Trasimeno panorama from Castiglione del Lago'},
  'luoghi-francescani-toscana-umbria':{it:'Santuario della Verna tra i boschi della Toscana',en:'La Verna Sanctuary in the Tuscan forest'},'franciscan-places-tuscany-umbria':{it:'Santuario della Verna tra i boschi della Toscana',en:'La Verna Sanctuary in the Tuscan forest'},
  'abbazia-di-san-galgano':{it:'Abbazia di San Galgano senza tetto nella campagna toscana',en:'Roofless San Galgano Abbey in the Tuscan countryside'},'san-galgano-abbey':{it:'Abbazia di San Galgano senza tetto nella campagna toscana',en:'Roofless San Galgano Abbey in the Tuscan countryside'},
  'cosa-vedere-a-pienza':{it:'Piazza Pio II nel centro storico rinascimentale di Pienza',en:'Piazza Pio II in Pienza’s Renaissance centre'},'what-to-see-in-pienza':{it:'Piazza Pio II nel centro storico rinascimentale di Pienza',en:'Piazza Pio II in Pienza’s Renaissance centre'},
  'firenze-in-un-giorno':{it:'Facciata del Duomo di Firenze',en:'Façade of Florence Cathedral'},'florence-in-one-day':{it:'Facciata del Duomo di Firenze',en:'Façade of Florence Cathedral'},
  firenze:{it:'Veduta del centro storico di Firenze',en:'View of Florence historic centre'},florence:{it:'Veduta del centro storico di Firenze',en:'View of Florence historic centre'},chianti:{it:'Piazza Matteotti nel borgo di Greve in Chianti',en:'Piazza Matteotti in Greve in Chianti'},'the-mall-firenze':{it:'Ingresso di The Mall Firenze a Leccio',en:'Entrance to The Mall Firenze in Leccio'},valdarno:{it:'Le Balze del Valdarno tra campi e vegetazione',en:'The Balze del Valdarno among fields and vegetation'},arezzo:{it:'Piazza Grande nel centro storico di Arezzo',en:'Piazza Grande in Arezzo historic centre'},siena:{it:'Piazza del Campo e Torre del Mangia a Siena',en:'Piazza del Campo and Torre del Mangia in Siena'},'reggello-vallombrosa':{it:'Abbazia di Vallombrosa riflessa nella vasca',en:'Vallombrosa Abbey reflected in the pool'},'1-giorno':{it:'Torri medievali di San Gimignano',en:'Medieval towers of San Gimignano'},'1-day':{it:'Torri medievali di San Gimignano',en:'Medieval towers of San Gimignano'},'2-giorni':{it:'Colline della Val d’Orcia',en:'Val d’Orcia hills'},'2-days':{it:'Colline della Val d’Orcia',en:'Val d’Orcia hills'},'3-giorni':{it:'Montefioralle tra i vigneti del Chianti',en:'Montefioralle among Chianti vineyards'},'3-days':{it:'Montefioralle tra i vigneti del Chianti',en:'Montefioralle among Chianti vineyards'}
};
const imagePositions: Record<string,string> = { valdarno:'center 48%',arezzo:'center 55%','reggello-vallombrosa':'center 46%','3-giorni':'center 52%','3-days':'center 52%' };
const legacyMeta: Record<string, { category: string; distanceKm: number; distanceMinutes: number; visitTime: string; featuredBadge?: string }> = {
  'borghi-toscani-poco-conosciuti':{category:'🏰 Borghi',distanceKm:18,distanceMinutes:30,visitTime:'1 giorno'},'hidden-villages-tuscany':{category:'🏰 Villages',distanceKm:18,distanceMinutes:30,visitTime:'1 day'},
  'lago-trasimeno-cosa-vedere':{category:'🏞 Panorama',distanceKm:85,distanceMinutes:80,visitTime:'1 giorno'},'lake-trasimeno-what-to-see':{category:'🏞 Landscape',distanceKm:85,distanceMinutes:80,visitTime:'1 day'},
  'luoghi-francescani-toscana-umbria':{category:'⛪ Abbazia',distanceKm:78,distanceMinutes:90,visitTime:'Weekend'},'franciscan-places-tuscany-umbria':{category:'⛪ Abbey',distanceKm:78,distanceMinutes:90,visitTime:'Weekend'},
  'abbazia-di-san-galgano':{category:'⛪ Abbazia',distanceKm:105,distanceMinutes:100,visitTime:'1 giorno'},'san-galgano-abbey':{category:'⛪ Abbey',distanceKm:105,distanceMinutes:100,visitTime:'1 day'},
  'cosa-vedere-a-pienza':{category:'🏰 Borgo',distanceKm:96,distanceMinutes:95,visitTime:'1 giorno',featuredBadge:'❤️ Preferita dagli ospiti'},'what-to-see-in-pienza':{category:'🏰 Village',distanceKm:96,distanceMinutes:95,visitTime:'1 day',featuredBadge:'❤️ Guest favourite'},
  'firenze-in-un-giorno':{category:'🏰 Città d’arte',distanceKm:38,distanceMinutes:45,visitTime:'1 giorno',featuredBadge:'🔥 Più visitata'},'florence-in-one-day':{category:'🏰 Art city',distanceKm:38,distanceMinutes:45,visitTime:'1 day',featuredBadge:'🔥 Most visited'},
  firenze:{category:'🏰 Città d’arte',distanceKm:38,distanceMinutes:45,visitTime:'1 giorno'},florence:{category:'🏰 Art city',distanceKm:38,distanceMinutes:45,visitTime:'1 day'},chianti:{category:'🍷 Vino',distanceKm:32,distanceMinutes:40,visitTime:'1 giorno'},
  'the-mall-firenze':{category:'🛍 Shopping',distanceKm:18,distanceMinutes:25,visitTime:'Mezza giornata'},valdarno:{category:'🌳 Natura',distanceKm:20,distanceMinutes:25,visitTime:'1 giorno'},arezzo:{category:'🏰 Città d’arte',distanceKm:52,distanceMinutes:50,visitTime:'1 giorno'},siena:{category:'🏰 Città d’arte',distanceKm:75,distanceMinutes:70,visitTime:'1 giorno'},'reggello-vallombrosa':{category:'🌳 Natura',distanceKm:28,distanceMinutes:40,visitTime:'1 giorno'},
  '1-giorno':{category:'🚗 Itinerario',distanceKm:0,distanceMinutes:0,visitTime:'1 giorno'},'1-day':{category:'🚗 Itinerary',distanceKm:0,distanceMinutes:0,visitTime:'1 day'},'2-giorni':{category:'🚗 Itinerario',distanceKm:0,distanceMinutes:0,visitTime:'Weekend'},'2-days':{category:'🚗 Itinerary',distanceKm:0,distanceMinutes:0,visitTime:'Weekend'},'3-giorni':{category:'🚗 Itinerario',distanceKm:0,distanceMinutes:0,visitTime:'Weekend'},'3-days':{category:'🚗 Itinerary',distanceKm:0,distanceMinutes:0,visitTime:'Weekend'}
};
const readLabel = lang === 'it' ? 'Leggi la guida' : 'Read the guide';
const meta = (item: CardItem) => ({ ...legacyMeta[item.slug], category: item.category ?? legacyMeta[item.slug]?.category, distanceKm: item.distanceKm ?? legacyMeta[item.slug]?.distanceKm, distanceMinutes: item.distanceMinutes ?? legacyMeta[item.slug]?.distanceMinutes, visitTime: item.visitTime ?? legacyMeta[item.slug]?.visitTime, featuredBadge: item.featuredBadge ?? legacyMeta[item.slug]?.featuredBadge });
const distance = (item: CardItem) => item.slug === 'hidden-villages-tuscany'
  ? '12 villages to discover from Perla Toscana'
  : item.slug === 'borghi-toscani-poco-conosciuti'
    ? '12 borghi da scoprire partendo da Perla Toscana'
    : meta(item).distanceKm === 0 ? (lang === 'it' ? 'Partenza da Perla Toscana' : 'Starts at Perla Toscana') : `${meta(item).distanceKm} km • ${meta(item).distanceMinutes} min ${lang === 'it' ? 'da' : 'from'} Perla Toscana`;
const visit = (item: CardItem) => `${lang === 'it' ? 'Visita consigliata' : 'Recommended visit'}: ${meta(item).visitTime}`;
---
<div class="archive-stack">
  <section class="archive-group"><h2>{lang === 'it' ? 'Città, borghi e destinazioni' : 'Cities, villages and destinations'}</h2><div class="archive-grid">{local.map((item) => <a class="archive-card" href={item.path} aria-label={`${readLabel}: ${item.h1}`}><img src={images[item.slug]} alt={imageAlts[item.slug]?.[lang] ?? item.socialImageAlt ?? item.h1} width="1200" height="800" loading="lazy" decoding="async" style={imagePositions[item.slug] ? `object-position:${imagePositions[item.slug]}` : undefined}/><div class="card-badges"><span class="category-badge">{meta(item).category}</span>{meta(item).featuredBadge && <span class="featured-badge">{meta(item).featuredBadge}</span>}</div><h3>{item.h1}</h3><div class="card-details"><span>🚗 {distance(item)}</span><span>🕒 {visit(item)}</span></div><p>{item.description}</p><strong aria-hidden="true">{readLabel} →</strong></a>)}</div></section>
  <section class="archive-group"><h2>{lang === 'it' ? 'Itinerari' : 'Itineraries'}</h2><div class="archive-grid">{itineraries.map((item) => <a class="archive-card" href={item.path} aria-label={`${readLabel}: ${item.h1}`}><img src={images[item.slug]} alt={imageAlts[item.slug]?.[lang] ?? item.socialImageAlt ?? item.h1} width="1200" height="800" loading="lazy" decoding="async" style={imagePositions[item.slug] ? `object-position:${imagePositions[item.slug]}` : undefined}/><div class="card-badges"><span class="category-badge">{meta(item).category}</span>{meta(item).featuredBadge && <span class="featured-badge">{meta(item).featuredBadge}</span>}</div><h3>{item.h1}</h3><div class="card-details"><span>🚗 {distance(item)}</span><span>🕒 {visit(item)}</span></div><p>{item.description}</p><strong aria-hidden="true">{readLabel} →</strong></a>)}</div></section>
</div>
<style>
.archive-stack,.archive-group{display:grid;gap:22px}.archive-stack{gap:48px}.archive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.archive-card{display:grid;min-width:0;gap:11px;overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-warm-white);box-shadow:var(--shadow-soft);color:var(--color-espresso);padding:0 22px 22px;text-decoration:none;transition:transform 180ms ease,box-shadow 180ms ease}.archive-card:hover,.archive-card:focus-visible{transform:translateY(-3px);box-shadow:0 16px 34px rgba(47,42,36,.13)}.archive-card img{width:calc(100% + 44px);height:172px;margin:0 -22px;object-fit:cover}.card-badges{display:flex;flex-wrap:wrap;gap:7px;align-items:center}.archive-card .category-badge,.archive-card .featured-badge{width:fit-content;border-radius:999px;font-size:.72rem;font-weight:800;line-height:1.25;padding:5px 9px}.category-badge{border:1px solid rgba(102,114,77,.22);background:rgba(102,114,77,.09);color:var(--color-olive)}.archive-card .featured-badge{border:1px solid rgba(174,89,57,.2);background:rgba(174,89,57,.09);color:var(--color-terracotta-dark)}.card-details{display:grid;gap:3px}.archive-card .card-details span{color:rgba(47,42,36,.78);font-size:.8rem;font-weight:700;line-height:1.4}.archive-card p{color:rgba(47,42,36,.76);font-size:.92rem;line-height:1.5}.archive-card strong{align-self:end;min-height:24px;color:var(--color-terracotta);margin-top:auto}.archive-card h3,.archive-card p{overflow-wrap:anywhere}@media(max-width:920px){.archive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.archive-grid{grid-template-columns:1fr}.archive-stack{gap:38px}.archive-card{padding-inline:20px}.archive-card img{width:calc(100% + 40px);height:190px;margin-inline:-20px}}
</style>
