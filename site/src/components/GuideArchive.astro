  'san-gimignano-things-to-do-towers-parking':{it:'Torri medievali di San Gimignano nel paesaggio collinare della Toscana',en:'Medieval towers of San Gimignano above the rolling Tuscan countryside'},
  'etruscans-valdarno-figline':{it:'Paesaggio delle Balze nel Valdarno Superiore',en:'The Balze landscape in Upper Valdarno'},
