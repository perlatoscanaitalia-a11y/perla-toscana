---
interface Props { lang?: 'it' | 'en'; }
const { lang = 'it' } = Astro.props;
---
<p class="editorial-signature">{lang === 'en' ? 'Guide created by the Perla Toscana team and reviewed regularly to provide travellers with useful, reliable information.' : 'Guida realizzata dal team Perla Toscana e aggiornata periodicamente per offrire informazioni utili ai viaggiatori.'}</p>
<style>.editorial-signature{border-top:1px solid var(--color-border);color:rgba(51,37,29,.68);font-size:.9rem;font-style:italic;padding-top:18px}</style>
