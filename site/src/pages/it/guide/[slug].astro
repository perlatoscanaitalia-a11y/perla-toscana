---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageContent from '../../../components/PageContent.astro';
import { guides } from '../../../data/guides';
import { faqSchema, guideSchema } from '../../../data/schema';

export function getStaticPaths() {
  return guides.it.filter(page => page.path.includes('/guide/') && page.slug !== 'borghi-toscani-poco-conosciuti').map(page => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const schema = [...guideSchema('it', page), faqSchema(page.faqs)].filter(Boolean);
---
<BaseLayout lang="it" title={page.title} description={page.description} path={page.path} alternatePath={page.alternatePath} schema={schema} ogType="article" socialImage={page.socialImage} socialImageAlt={page.socialImageAlt} socialImageWidth={page.socialImageWidth} socialImageHeight={page.socialImageHeight}>
  <PageContent lang="it" page={page} />
</BaseLayout>
