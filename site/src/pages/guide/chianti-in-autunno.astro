---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContent from '../../components/PageContent.astro';
import { chiantiAutunnoPage as page } from '../../data/guideChiantiAutunno';
import { faqSchema, guideSchema } from '../../data/schema';
const schema = [...guideSchema('it', page), faqSchema(page.faqs)].filter(Boolean);
---
<BaseLayout lang="it" title={page.title} description={page.description} path={page.path} schema={schema} ogType="article" socialImage={page.socialImage} socialImageAlt={page.socialImageAlt} socialImageWidth={page.socialImageWidth} socialImageHeight={page.socialImageHeight}>
  <PageContent lang="it" page={page} />
</BaseLayout>
