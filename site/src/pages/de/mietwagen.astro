---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';

const path = '/de/mietwagen/';
const title = 'Mietwagen Florenz für den Toskana-Urlaub | Perla Toscana';
const description = 'Vergleichen Sie Mietwagenangebote in Florenz und entdecken Sie das Chianti, Florenz und die Toskana flexibel während Ihres Aufenthalts bei Perla Toscana.';
const canonical = new URL(path, siteConfig.siteUrl).toString();
const alternatePaths = {
  it: '/it/noleggio-auto/',
  en: '/en/car-rental/',
  de: '/de/mietwagen/'
};
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    inLanguage: 'de-DE',
    isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.siteUrl }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Perla Toscana', item: new URL('/de/', siteConfig.siteUrl).toString() },
      { '@type': 'ListItem', position: 2, name: 'Mietwagen in Florenz', item: canonical }
    ]
  }
];
---

<BaseLayout lang="de" title={title} description={description} path={path} alternatePaths={alternatePaths} schema={schema}>
  <section class="section rental-hero">
    <div class="container rental-hero__inner">
      <nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
        <a href="/de/">Perla Toscana</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Mietwagen</span>
      </nav>
      <p class="eyebrow">Unterwegs in der Toskana</p>
      <h1>Mietwagen in Florenz für Ihren Toskana-Urlaub</h1>
      <p class="lead">Perla Toscana ist ein idealer Ausgangspunkt, um Florenz, das Chianti und einige der schönsten Orte der Toskana zu entdecken. Wenn Sie ohne eigenes Auto anreisen, bietet Ihnen ein Mietwagen die Freiheit, die Region ganz flexibel zu erkunden.</p>
    </div>
  </section>

  <section class="section rental-widget-section" aria-labelledby="rental-widget-title">
    <div class="container rental-widget-wrap">
      <h2 id="rental-widget-title" class="visually-hidden">Mietwagenangebote vergleichen</h2>
      <div class="rental-widget">
        <div><script id="dchwidget" src="https://www.discovercars.com/widget.js?v1" data-dev-env="com" data-location="italy-mainland/florence/florence-airport-flo" data-lang="de" data-currency="eur" data-utm-source="Fi" data-utm-medium="widget" data-aff-code="a_aid" data-autocomplete="on" data-style-submit-bg-color="#007ac2" data-style-submit-font-color="#ffffff" data-style-form-bg-color="#f3ebdd" data-style-form-font-color="#000000" data-style-submit-text="Mietwagen finden" data-style-title-color="#000000" data-title-text="Mietwagen vergleichen und bis zu 70 % sparen" async="async" data-style_rounded_corners="on" data-localization_currency_box="on" data-layout_benefits="on" data-layout_description="on" data-layout_description_text="Vergleichen Sie Angebote vertrauenswürdiger Autovermietungen und finden Sie den passenden Mietwagen für Ihre Reise in die Toskana." data-layout_logo_style="on dark" data-layout_powered_by="on" data-layout_style_form_bg_color="#007ac2" data-layout_title="on"></script></div>
      </div>
      <p class="affiliate-note"><strong>Affiliate-Link:</strong> Perla Toscana kann für Buchungen über diesen Service eine Provision erhalten. Für Sie entstehen dadurch keine zusätzlichen Kosten.</p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container rental-reasons">
      <div>
        <p class="eyebrow">Flexibel unterwegs</p>
        <h2>Warum ein Auto in der Toskana praktisch ist</h2>
        <p>Mit dem Auto können Sie Ihre Ausflüge flexibel planen und erreichen auch ländliche Ziele, die mit öffentlichen Verkehrsmitteln nicht immer gut angebunden sind.</p>
      </div>
      <ul class="destination-list">
        <li>Florenz</li>
        <li>Das Chianti</li>
        <li>Greve in Chianti</li>
        <li>Siena</li>
        <li>Arezzo</li>
        <li>Kleine Orte, Weingüter und Ziele auf dem Land</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .rental-hero { background: var(--color-sand); }
  .rental-hero__inner { display: grid; gap: 22px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 6px; color: rgba(47, 42, 36, 0.68); font-size: 0.84rem; }
  .breadcrumbs a { color: var(--color-olive); }
  .rental-widget-section { background: var(--color-cream); }
  .rental-widget-wrap { display: grid; justify-items: center; gap: 24px; }
  .rental-widget { width: min(100%, 960px); min-width: 0; overflow: visible; }
  .affiliate-note { max-width: 820px; color: rgba(47, 42, 36, 0.72); font-size: 0.88rem; line-height: 1.55; text-align: center; }
  .rental-reasons { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  .rental-reasons > div { display: grid; gap: 16px; }
  .destination-list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .destination-list li { position: relative; border-bottom: 1px solid var(--color-border); padding: 10px 12px 10px 30px; }
  .destination-list li::before { position: absolute; top: 1.05rem; left: 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--color-terracotta); content: ''; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 720px) {
    .rental-hero h1 { max-width: 100%; font-size: clamp(1.95rem, 9vw, 2.2rem); }
    .rental-reasons { grid-template-columns: 1fr; }
    .rental-widget-wrap { gap: 18px; }
    .affiliate-note { text-align: left; }
  }
</style>
