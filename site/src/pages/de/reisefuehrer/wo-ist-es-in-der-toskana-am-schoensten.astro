  .guide-hero h1{max-width:980px;color:var(--color-warm-white);font-size:clamp(2.35rem,5.8vw,5rem);line-height:.98;text-shadow:0 2px 20px rgba(0,0,0,.3)}
  .guide-hero .lead{max-width:800px;font-size:clamp(1.05rem,2vw,1.24rem)}
  .guide-hero .eyebrow{color:#fff}
