---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageContent from '../../../components/PageContent.astro';
import { hiddenVillagesDe as page } from '../../../data/guideHiddenVillages';
import { faqSchema, guideSchema } from '../../../data/schema';
const schema = [...guideSchema('de', page), faqSchema(page.faqs)].filter(Boolean);
---
<BaseLayout lang="de" title={page.title} description={page.description} path={page.path} alternatePaths={page.alternatePaths} schema={schema} ogType="article" socialImage={page.socialImage} socialImageAlt={page.socialImageAlt}>
  <PageContent lang="de" page={page} />
</BaseLayout>
