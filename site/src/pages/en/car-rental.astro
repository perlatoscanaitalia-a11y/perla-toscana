---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';

const path = '/en/car-rental/';
const title = 'Car Rental in Florence for Tuscany | Perla Toscana';
const description = 'Compare car rental deals in Florence and explore Chianti, Florence and Tuscany at your own pace during your stay at Perla Toscana.';
const canonical = new URL(path, siteConfig.siteUrl).toString();
const alternatePaths = {
  it: '/it/noleggio-auto/',
  en: '/en/car-rental/',
  de: '/de/mietwagen/'
};
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.siteUrl }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Perla Toscana', item: new URL('/en/', siteConfig.siteUrl).toString() },
      { '@type': 'ListItem', position: 2, name: 'Car rental in Florence', item: canonical }
    ]
  }
];
---

<BaseLayout lang="en" title={title} description={description} path={path} alternatePaths={alternatePaths} schema={schema}>
  <section class="section rental-hero">
    <div class="container rental-hero__inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/en/">Perla Toscana</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Car rental</span>
      </nav>
      <p class="eyebrow">Getting around Tuscany</p>
      <h1>Car Rental in Florence for Your Stay in Tuscany</h1>
      <p class="lead">Perla Toscana is ideally located for exploring Florence, the Chianti countryside and some of Tuscany's most beautiful towns and villages. If you're arriving without a car, renting one gives you the freedom to discover the area at your own pace.</p>
    </div>
  </section>

  <section class="section rental-widget-section" aria-labelledby="rental-widget-title">
    <div class="container rental-widget-wrap">
      <h2 id="rental-widget-title" class="visually-hidden">Compare car rental deals</h2>
      <div class="rental-widget">
        <div><script id="dchwidget" src="https://www.discovercars.com/widget.js?v1" data-dev-env="com" data-location="italy-mainland/florence/florence-airport-flo" data-lang="en" data-currency="eur" data-utm-source="Fi" data-utm-medium="widget" data-aff-code="a_aid" data-autocomplete="on" data-style-submit-bg-color="#007ac2" data-style-submit-font-color="#ffffff" data-style-form-bg-color="#f3ebdd" data-style-form-font-color="#000000" data-style-submit-text="Find a car" data-style-title-color="#000000" data-title-text="Compare car rentals and save up to 70%" async="async" data-style_rounded_corners="on" data-layout_benefits="on" data-layout_description="on" data-layout_description_text="Compare deals from trusted car rental companies and find the right car for your trip to Tuscany." data-layout_logo_style="on dark" data-layout_powered_by="on" data-layout_style_form_bg_color="#f3ebdd" data-layout_title="on"></script></div>
      </div>
      <p class="affiliate-note"><strong>Affiliate link:</strong> Perla Toscana may receive a commission on bookings made through this service, at no additional cost to you.</p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container rental-reasons">
      <div>
        <p class="eyebrow">Explore at your own pace</p>
        <h2>Why having a car helps in Tuscany</h2>
        <p>A car makes it easier to plan each day around your own schedule, especially when visiting countryside destinations that are not always well served by public transport.</p>
      </div>
      <ul class="destination-list">
        <li>Florence</li>
        <li>The Chianti countryside</li>
        <li>Greve in Chianti</li>
        <li>Siena</li>
        <li>Arezzo</li>
        <li>Small towns, wineries and countryside destinations</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .rental-hero { background: var(--color-sand); }
  .rental-hero__inner { display: grid; gap: 22px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 6px; color: rgba(47, 42, 36, 0.68); font-size: 0.84rem; }
  .breadcrumbs a { color: var(--color-olive); }
  .rental-widget-section { background: var(--color-cream); }
  .rental-widget-wrap { display: grid; justify-items: center; gap: 24px; }
  .rental-widget { width: min(100%, 960px); min-width: 0; overflow: visible; }
  .affiliate-note { max-width: 820px; color: rgba(47, 42, 36, 0.72); font-size: 0.88rem; line-height: 1.55; text-align: center; }
  .rental-reasons { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  .rental-reasons > div { display: grid; gap: 16px; }
  .destination-list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .destination-list li { position: relative; border-bottom: 1px solid var(--color-border); padding: 10px 12px 10px 30px; }
  .destination-list li::before { position: absolute; top: 1.05rem; left: 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--color-terracotta); content: ''; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 720px) {
    .rental-hero h1 { max-width: 100%; font-size: clamp(1.95rem, 9vw, 2.2rem); }
    .rental-reasons { grid-template-columns: 1fr; }
    .rental-widget-wrap { gap: 18px; }
    .affiliate-note { text-align: left; }
  }
</style>
