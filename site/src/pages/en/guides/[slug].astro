---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageContent from '../../../components/PageContent.astro';
import { guides } from '../../../data/guides';
import { faqSchema, guideSchema } from '../../../data/schema';

export function getStaticPaths() {
  return guides.en.filter(page => page.path.includes('/guides/') && !['figline-valdarno', 'hidden-villages-tuscany'].includes(page.slug)).map(page => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const schema = [...guideSchema('en', page), faqSchema(page.faqs)].filter(Boolean);
---
<BaseLayout lang="en" title={page.title} description={page.description} path={page.path} alternatePath={page.alternatePath} alternatePaths={page.alternatePaths} schema={schema} ogType="article" socialImage={page.socialImage} socialImageAlt={page.socialImageAlt} socialImageWidth={page.socialImageWidth} socialImageHeight={page.socialImageHeight}>
  <PageContent lang="en" page={page} />
</BaseLayout>
