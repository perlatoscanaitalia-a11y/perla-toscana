---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageContent from '../../../components/PageContent.astro';
import { bagniSanFilippoPageEn as page } from '../../../data/guideBagniSanFilippo';
import { faqSchema, guideSchema } from '../../../data/schema';
const schema = [...guideSchema('en', page), faqSchema(page.faqs)].filter(Boolean);
---
<BaseLayout lang="en" title={page.title} description={page.description} path={page.path} alternatePath={page.alternatePath} schema={schema} ogType="article" socialImage={page.socialImage} socialImageAlt={page.socialImageAlt}>
  <PageContent lang="en" page={page} />
</BaseLayout>
