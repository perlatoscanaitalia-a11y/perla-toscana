---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageContent from '../../../components/PageContent.astro';
import { hiddenVillagesEn as page } from '../../../data/guideHiddenVillages';
import { faqSchema, guideSchema } from '../../../data/schema';
const schema = [...guideSchema('en', page), faqSchema(page.faqs)].filter(Boolean);
---
<BaseLayout lang="en" title={page.title} description={page.description} path={page.path} alternatePaths={page.alternatePaths} schema={schema} ogType="article" socialImage={page.socialImage} socialImageAlt={page.socialImageAlt} socialImageWidth={page.socialImageWidth} socialImageHeight={page.socialImageHeight}>
  <PageContent lang="en" page={page} />
</BaseLayout>
