  .guide-hero>img,.guide-hero__overlay{position:absolute;inset:0;width:100%;height:100%}
  .guide-hero>img{object-fit:cover;object-position:center 48%}
  .guide-hero__overlay{background:linear-gradient(180deg,rgba(30,22,17,.12) 8%,rgba(30,22,17,.84) 100%)}
  .guide-hero__content{position:relative;z-index:1;display:grid;gap:15px;padding-block:64px}
  .guide-hero h1{max-width:900px;color:var(--color-warm-white);font-size:clamp(2.45rem,6.2vw,5.25rem);line-height:.96;text-shadow:0 2px 20px rgba(0,0,0,.28)}
  .guide-hero .lead{max-width:760px;font-size:clamp(1.05rem,2vw,1.24rem)}
  .breadcrumb,.article-dates{display:flex;flex-wrap:wrap;gap:8px 12px;color:rgba(255,255,255,.88);font-size:.88rem}
  .breadcrumb a{color:#fff;font-weight:700;text-decoration:none}
  .guide-hero .eyebrow{color:#fff}
  .guide-layout{display:grid;grid-template-columns:250px minmax(0,800px);gap:54px;align-items:start}
  .toc{position:sticky;top:96px;padding:20px}
  .toc h2{font-size:1.35rem;margin-bottom:12px}
  .toc ol{display:grid;gap:8px;padding-left:20px}
  .toc a{color:var(--color-olive);font-size:.9rem;text-decoration:none}
  .content{display:grid;gap:42px;font-size:1.04rem}
  .content section{display:grid;gap:16px;scroll-margin-top:100px}
  .content h2{max-width:24ch;font-size:clamp(1.8rem,4vw,2.55rem);line-height:1.08;text-wrap:balance}
  .content h3{margin-top:8px;font-size:clamp(1.35rem,2.5vw,1.75rem)}
  .content p,.content li{max-width:72ch;line-height:1.7}
  .content a:not(.button){color:var(--color-terracotta-dark);font-weight:700}
  .intro-copy{display:grid;gap:14px;font-size:1.12rem}
  figure{display:grid;gap:9px;margin:4px 0 10px}
  figure img{width:100%;height:auto;border-radius:18px;object-fit:cover}
  figcaption{color:rgba(47,42,36,.7);font-size:.84rem;line-height:1.45}
  .comparison-section>figure img{aspect-ratio:16/9}
  .feature-section{overflow:hidden}
  .base-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .base-grid article{display:grid;align-content:start;gap:8px;padding:22px}
  .base-grid h3{margin:0}
  .base-grid p{font-size:.96rem}
  .itinerary-list,.decision-list{display:grid;gap:12px;padding-left:22px}
  .property{padding:28px;border-color:rgba(166,83,50,.28);background:linear-gradient(135deg,rgba(166,83,50,.07),rgba(247,241,232,.74))}
  .property figure img{aspect-ratio:3/2}
  .button-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:4px}
  @media(max-width:850px){.guide-layout{grid-template-columns:1fr;gap:30px}.toc{position:static}.guide-hero__content{padding-block:48px}}
  @media(max-width:620px){.guide-hero{min-height:590px}.base-grid{grid-template-columns:1fr}.property{padding:22px}.button-row .button{width:100%;text-align:center}}
</style>
